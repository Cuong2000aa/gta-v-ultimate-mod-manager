/* Dark theme for GTA V Ultimate Mod Manager.
   Colour tokens are substituted by gui.theme.palette before the sheet is
   applied, so the palette stays the single source of truth. */

QWidget {
    background-color: @bg;
    color: @text;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: @bg;
}

/* ---------------------------------------------------------------- Sidebar */
#Sidebar {
    background-color: @bg_elevated;
    border-right: 1px solid @border;
}

#SidebarHeader {
    color: @text_muted;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 16px 18px 6px 18px;
}

#AppTitle {
    font-size: 15px;
    font-weight: 700;
    color: @text;
    padding: 18px 18px 2px 18px;
}

#AppSubtitle {
    font-size: 11px;
    color: @text_muted;
    padding: 0 18px 14px 18px;
}

QPushButton#NavButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: @text_muted;
    text-align: left;
    padding: 10px 18px;
    font-size: 13px;
}

QPushButton#NavButton:hover {
    background-color: @bg_hover;
    color: @text;
}

QPushButton#NavButton:checked {
    background-color: @bg_selected;
    border-left: 3px solid @accent;
    color: @text;
    font-weight: 600;
}

/* ----------------------------------------------------------------- Cards */
#Card {
    background-color: @bg_elevated;
    border: 1px solid @border;
    border-radius: 10px;
}

#CardTitle {
    font-size: 12px;
    font-weight: 600;
    color: @text_muted;
    letter-spacing: 0.5px;
}

#CardValue {
    font-size: 22px;
    font-weight: 700;
    color: @text;
}

#PageTitle {
    font-size: 21px;
    font-weight: 700;
}

#PageSubtitle {
    font-size: 12px;
    color: @text_muted;
}

#SectionTitle {
    font-size: 14px;
    font-weight: 600;
    padding-top: 4px;
}

#Hint {
    color: @text_muted;
    font-size: 12px;
}

/* --------------------------------------------------------------- Buttons */
QPushButton {
    background-color: @bg_hover;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 7px 16px;
    color: @text;
}

QPushButton:hover {
    background-color: @bg_selected;
    border-color: @border_strong;
}

QPushButton:pressed {
    background-color: @bg;
}

QPushButton:disabled {
    color: @text_disabled;
    background-color: @bg_elevated;
    border-color: @border;
}

QPushButton#PrimaryButton {
    background-color: @accent;
    border: 1px solid @accent;
    color: #0b0f14;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}

QPushButton#PrimaryButton:disabled {
    background-color: @bg_selected;
    border-color: @border;
    color: @text_disabled;
}

QPushButton#DangerButton {
    border-color: @danger;
    color: @danger;
}

QPushButton#DangerButton:hover {
    background-color: @danger;
    color: #0b0f14;
}

/* ----------------------------------------------------------------- Input */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: @bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 7px 10px;
    selection-background-color: @accent;
    selection-color: #0b0f14;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border-color: @accent;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: @bg_elevated;
    border: 1px solid @border;
    selection-background-color: @bg_selected;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @border_strong;
    border-radius: 4px;
    background-color: @bg;
}

QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

/* ------------------------------------------------------- Tables & trees */
QTableView, QTreeWidget, QTreeView, QListWidget {
    background-color: @bg_elevated;
    alternate-background-color: @bg_alt;
    border: 1px solid @border;
    border-radius: 8px;
    gridline-color: @border;
    selection-background-color: @bg_selected;
    selection-color: @text;
    outline: none;
}

QTableView::item, QTreeWidget::item, QListWidget::item {
    padding: 6px 4px;
    border: none;
}

QHeaderView::section {
    background-color: @bg;
    color: @text_muted;
    border: none;
    border-bottom: 1px solid @border;
    padding: 8px 6px;
    font-weight: 600;
}

QTableView::item:selected, QTreeWidget::item:selected {
    background-color: @bg_selected;
}

/* ----------------------------------------------------------- Scroll bars */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: @border_strong;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: @text_muted;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: @border_strong;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

/* -------------------------------------------------------- Progress & tabs */
QProgressBar {
    background-color: @bg;
    border: 1px solid @border;
    border-radius: 6px;
    height: 14px;
    text-align: center;
    color: @text;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: @accent;
    border-radius: 5px;
}

QProgressBar#LibraryProgress {
    min-height: 22px;
    height: 22px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#LibraryProgressLabel {
    color: @accent;
    font-size: 13px;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid @border;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: @text_muted;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: @text;
    border-bottom: 2px solid @accent;
}

/* ----------------------------------------------------------- Drop target */
#DropArea {
    border: 2px dashed @border_strong;
    border-radius: 12px;
    background-color: @bg_elevated;
}

#DropArea[dragActive="true"] {
    border-color: @accent;
    background-color: @bg_selected;
}

#DropAreaTitle {
    font-size: 15px;
    font-weight: 600;
}

/* ---------------------------------------------------------------- Toasts */
#Toast {
    border-radius: 8px;
    border: 1px solid @border_strong;
    background-color: @bg_elevated;
}

#ToastTitle {
    font-weight: 700;
}

#ToastMessage {
    color: @text_muted;
}

/* ---------------------------------------------------------------- Badges */
QLabel#BadgeOk {
    background-color: @success_bg;
    color: @success;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#BadgeWarn {
    background-color: @warning_bg;
    color: @warning;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#BadgeError {
    background-color: @danger_bg;
    color: @danger;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#BadgeNeutral {
    background-color: @bg_selected;
    color: @text_muted;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QStatusBar {
    background-color: @bg_elevated;
    border-top: 1px solid @border;
    color: @text_muted;
}

QStatusBar::item {
    border: none;
}

QSplitter::handle {
    background-color: @border;
}

QToolTip {
    background-color: @bg_elevated;
    color: @text;
    border: 1px solid @border_strong;
    padding: 6px;
}
